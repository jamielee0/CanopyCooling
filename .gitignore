# ===========================================================================
# Canopy protocol .gitignore
# Git tracks ONLY code, config, and small text manifests.
# Downloaded data and credentials are never committed.
# ===========================================================================

# ---- data directories: ignore contents, keep the README placeholders ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/README.md
!data/interim/README.md
!data/processed/README.md
# (data/manifest.csv lives directly under data/ and IS tracked.)

# ---- large rasters / arrays / EO files (anywhere in the tree) ----
*.tif
*.tiff
*.nc
*.nc4
*.cdf
*.hdf
*.hdf5
*.h5
*.he5
*.grib
*.grib2
*.grb
*.zarr/
*.vrt
*.img
*.jp2
*.bil
*.bsq
*.dat
*.npy
*.npz
*.parquet
*.feather

# ---- credentials / secrets (never commit) ----
.env
.env.*
.netrc
_netrc
.cdsapirc
*.pem
*.key
*.p12
*.pfx
secrets.*
*secret*
*credential*
service-account*.json
.config/earthengine/

# ---- python ----
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- os / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- generated figures (regenerated from code; not committed) ----
figures/*
!figures/README.md
